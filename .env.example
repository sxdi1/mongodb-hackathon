DEMO_MODE=true
STORAGE=mongo
# Required when STORAGE=mongo:
MONGODB_URI=mongodb+srv://...
MONGODB_DB=splitsmart
# For local-only development, use STORAGE=sqlite and SQLITE_PATH=splitsmart.sqlite.
AGENT_MODE=mock
# AGENT_MODE=gemini
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash
# Required outside demo mode: JSON map of long random bearer tokens to seeded member IDs.
# AUTH_TOKENS={"replace-with-random-secret":"alex"}
